# Backend configuration
DATABASE_URL=
PGUSER=
PGPASSWORD=
PGHOST=

# Browser origins allowed to use credentialed API requests
FRONTEND_ORIGINS=http://localhost:3000

# JWT secrets
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Google sign-in
SIGN_IN_W_GOOGLE_CLIENT_ID=
SIGN_IN_W_GOOGLE_CLIENT_SECRET=

# Email delivery through Brevo SMTP
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
VERIFICATION_EMAIL=

# External course data
GQL_URL=

# Optional request-size override, in bytes
MAX_CONTENT_LENGTH=524288
